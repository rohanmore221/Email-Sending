# Google OAuth 2.0 Credentials (for 1-click Sign in with Google & Gmail API dispatch)
# Create in Google Cloud Console -> APIs & Services -> Credentials -> OAuth 2.0 Client ID (Web Application)
# Authorized redirect URI: http://127.0.0.1:8000/api/auth/google/callback
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_REDIRECT_URI=http://127.0.0.1:8000/api/auth/google/callback

# Fallback: SMTP Credentials (if not using Google OAuth)
# For Gmail: Use a 16-character Google App Password (NOT your regular account password)
# Generate one at: https://myaccount.google.com/apppasswords
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASSWORD=your_16_digit_app_password

# Sender profile details
SENDER_NAME=Rohan More
SENDER_PHONE=+91-8652492520
